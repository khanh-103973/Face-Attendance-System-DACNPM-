# Documentation only. Set these values in PowerShell; .env is not auto-loaded.
DB_URL=jdbc:postgresql://localhost:5432/face_attendance
DB_USERNAME=attendance_app
DB_PASSWORD=
SERVER_PORT=8080
# Start-Backend.ps1 creates/loads the private key locally; never commit its value.
JWT_SECRET_BASE64=
# Only needed once to bootstrap admin; never a database password.
BOOTSTRAP_ADMIN_PASSWORD=
AI_SERVICE_URL=http://127.0.0.1:8000
# Startup scripts load the shared key from .secrets/ai-service.key.
AI_API_KEY=
